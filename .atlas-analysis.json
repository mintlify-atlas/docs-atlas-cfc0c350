  "keyFeatures": [
    "Threshold Schnorr signatures (Lindell22)",
    "Threshold ECDSA with multiple variants (DKLs23, Lindell17)",
    "Threshold BLS signatures (Boldyreva02)",
    "Distributed key generation (DKG) and secret sharing",
    "Sigma protocols with Fiat-Shamir and Fischlin compilers",
    "Homomorphic encryption (Paillier)",
    "Zero-knowledge proofs with composition (AND/OR)",
    "Oblivious transfer and OT extensions",
    "Side-channel resistant elliptic curve operations",
    "Modular and reusable cryptographic components"
  ],
  "publicApiSurface": [
    "pkg/mpc/tsig/tschnorr/lindell22",
    "pkg/mpc/tsig/tecdsa/dkls23",
